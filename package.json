{
  "name": "apix",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "pnpm dev:browser",
    "dev:browser": "concurrently -k --names backend,browser --prefix-colors green,yellow \"pnpm dev:backend\" \"node scripts/open-dev-browser.mjs\"",
    "dev:backend": "node scripts/dev-runtime.mjs",
    "check": "node scripts/check-web.mjs",
    "test:web": "node --test runtime/internal/activity/*_web_test.mjs",
    "test": "pnpm test:web && pnpm test:runtime",
    "test:runtime": "cd runtime && go test ./...",
    "build": "pnpm build:runtime",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:windows-desktop": "node scripts/test-windows-desktop.mjs",
    "test:windows-wsl": "node scripts/test-windows-wsl.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1"
  }
}
