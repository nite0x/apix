{
  "name": "apix",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "pnpm dev:browser",
    "dev:browser": "concurrently -k --names backend,browser --prefix-colors green,yellow \"pnpm dev:backend\" \"node scripts/open-dev-browser.mjs\"",
    "dev:backend": "node scripts/dev-runtime.mjs",
    "check": "pnpm typecheck && pnpm lint && node scripts/check-web.mjs",
    "test:web": "pnpm test:ui",
    "test": "pnpm test:web && pnpm test:runtime",
    "test:runtime": "pnpm build:web && cd runtime && go test ./...",
    "build": "pnpm build:desktop",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:windows-wsl": "node scripts/test-windows-wsl.mjs",
    "dev:desktop": "tauri dev",
    "tauri": "tauri",
    "build:desktop": "tauri build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "test:sidecar": "node scripts/test-sidecar.mjs",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "lint": "eslint frontend/src --max-warnings=0",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
